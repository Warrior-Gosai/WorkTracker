# ====================================================================
# DevWork Tracker - Root .gitignore
# ====================================================================

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor files
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output directories
target/
**/target/
dist/
**/dist/
build/
**/build/
out/
**/out/

# Node & Frontend dependencies
node_modules/
**/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
!*.example

# Log files
logs/
**/logs/
*.log

# Database and docker volumes
pgdata/
postgres_data/

# Temporary and export files
*.tmp
*.bak
 DevWork_Tracker_Export*.zip
**/exports/*.xlsx
**/exports/*.zip
scratch/
